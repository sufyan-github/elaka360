// Public read API on Cloudflare Workers + Turso (apps/edge-api). Deployed by .github/workflows/deploy.yml.
// The database comes from two Worker secrets, TURSO_DATABASE_URL (libsql://<db>-<org>.turso.io) and TURSO_AUTH_TOKEN
// (`wrangler secret put`; the deploy workflow sets them from GitHub secrets). Local dev: `pnpm dev` points at a local
// libSQL server on port 8080. The website reaches this Worker through a service binding (no public hop).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elaka360-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "elaka360-api.abusufyan.online", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": { "APP_VERSION": "dev" }
}
