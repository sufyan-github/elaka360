// Cloudflare Worker for the public website (built by @opennextjs/cloudflare; deployed by .github/workflows/deploy.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elaka360-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "elaka360.abusufyan.online", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  // Runtime settings (not secrets). NEXT_PUBLIC_* values are baked in at build time by the workflow.
  "vars": {
    "API_URL": "https://elaka360-api.abusufyan.online",
    "TRUST_CF_CONNECTING_IP": "1",
    "PUBLIC_SITE_URL": "https://elaka360.abusufyan.online",
    "API_TIMEOUT_MS": "8000"
  },
  // ISR cache: R2 bucket for pages, Durable Object queue for time-based revalidation
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "elaka360-web-cache" }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "elaka360-web" }],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
