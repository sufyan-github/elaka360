# API
DATABASE_URL=postgres://elaka360:elaka360@localhost:5432/elaka360
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Required in production (>= 32 chars). Development falls back to a random per-process secret.
AUTH_JWT_SECRET=
# OTP delivery: unset = sign-in disabled; "dev" = code shown in the response (refused in production)
SMS_PROVIDER=
# Data trust: true (default) = unverified records are shown with warnings; false = only sourced records (docs/data/DATA_TRUST_POLICY.md)
PUBLIC_INCLUDE_UNVERIFIED=true
# Search (optional — falls back to Postgres when unset)
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-key

# Web + admin
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
